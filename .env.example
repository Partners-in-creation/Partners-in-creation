# Copy to .env and fill in. Never commit the real .env.

# Database. SQLite works out of the box; for Postgres change the provider in
# prisma/schema.prisma to "postgresql" and use a postgres:// URL.
DATABASE_URL="file:./dev.db"

# Public address of the site, used in email links and calendar files.
SITE_URL="http://localhost:3000"

# Admin dashboard password, and a long random string for signing sessions
# (for example the output of: openssl rand -base64 32).
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Email. Use a sender address made just for this site (e.g. on the site's own
# domain), never a personal inbox. Without SMTP_URL, emails are only saved in
# the admin "Sent emails" page.
EMAIL_FROM="Partners In Creation <notifications@example.com>"
SMTP_URL=""            # e.g. smtps://USER:PASSWORD@smtp.your-provider.com:465
ADMIN_NOTIFY_EMAIL=""  # where to send "someone asked to attend" alerts (optional)

# Reminders: a scheduler calls /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
REMINDER_HOURS_BEFORE="24"

# Audio storage. Leave S3_* empty to store files on the server disk.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="500"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""         # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""       # public base URL files are played from, e.g. https://audio.example.com
